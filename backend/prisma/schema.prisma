// Prisma schema - ExecUI
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- Core multi-tenant models --------------------------------------------------

model Tenant {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  code             String?  @unique
  createdAt        DateTime @default(now())
  stripeCustomerId String?
  stripePlanId     String?
  stripeSubId      String?
  plan             String   @default("executive")
  planSolutions    String[] @default([])

  // Selected industry vertical. "general" ⇒ core CRM only (unchanged behavior);
  // any other value additively unlocks that industry's modules.
  industry       String @default("general")
  // Network Management scale. "office" ⇒ small-office view (internet + routers +
  // devices, no datacenter clutter); "datacenter" ⇒ the full enterprise view.
  networkProfile String @default("office")

  users                   User[]
  roles                   Role[]
  contacts                Contact[]
  crmTasks                CrmTask[]
  crmTickets              CrmTicket[]
  crmFollowUps            CrmFollowUp[]
  crmOpportunities        CrmOpportunity[]
  crmServiceUsages        CrmServiceUsage[]
  marketingTodos          MarketingTodo[]
  scheduleEvents          MarketingScheduleEvent[]
  activities              MarketingActivity[]
  campaigns               MarketingCampaign[]
  audiences               MarketingAudience[]
  experiments             MarketingExperiment[]
  bizTransactions         BizTransaction[]
  bizTaxPlans             BizTaxPlan[]
  bizInvestments          BizInvestment[]
  bizSOPs                 BizSOP[]
  bizWorkflows            BizWorkflow[]
  bizGoals                BizGoal[]
  bizMarketAnalysis       BizMarketAnalysis[]
  bizCampaigns            BizCampaign[]
  bizClients              BizClient[]
  bizMembers              BizMember[]
  bizProjects             BizProject[]
  bizTasks                BizTask[]
  networkDevices          NetworkDevice[]
  networkAlerts           NetworkAlert[]
  networkIncidents        NetworkIncident[]
  networkChanges          NetworkChange[]
  networkBackups          NetworkBackup[]
  networkServers          NetworkServer[]
  networkUserRestrictions NetworkUserRestriction[]
  firewallRules           FirewallRule[]
  userSessions            UserSession[]
  auditLogs               AuditLog[]
  aiUsages                AiUsage[]
  industryRecords         IndustryRecord[]
  socialAccounts          SocialAccount[]
  socialPosts             SocialPost[]
  socialEngagements       SocialEngagement[]
  socialSnapshots         SocialFollowerSnapshot[]
  networkConnections      NetworkConnection[]
  rewardEvents            RewardEvent[]
  rewardStats             RewardStat[]
  reports                 Report[]
  reportSchedules         ReportSchedule[]
  apiTokens               ApiToken[]
  webhookEndpoints        WebhookEndpoint[]
  webhookDeliveries       WebhookDelivery[]
  workflows               Workflow[]
  workflowRuns            WorkflowRun[]
  approvalRequests        ApprovalRequest[]
  approvalDecisions       ApprovalDecision[]
  ssoConnection           SsoConnection?
  scimTokens              ScimToken[]
  ssoLoginRequests        SsoLoginRequest[]
}

// An internet/WAN connection — the backbone of a small office's network. Lets a
// company with no servers still monitor its ISP links, bandwidth and data usage.
model NetworkConnection {
  id             String   @id @default(uuid())
  tenantId       String
  name           String // "Primary Fiber"
  provider       String? // ISP, e.g. "Orange Liberia"
  linkType       String   @default("fiber") // fiber | dsl | lte | fixed_wireless | satellite | other
  role           String   @default("primary") // primary | backup
  downMbps       Float? // plan download speed
  upMbps         Float? // plan upload speed
  ipAddress      String? // public / WAN IP
  gateway        String? // router / gateway IP
  status         String   @default("up") // up | down | degraded
  monthlyUsageGb Float    @default(0)
  dataCapGb      Float? // null = unlimited
  monthlyCost    Float?
  currency       String   @default("LRD")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// A connected business social account (Facebook page, Instagram, WhatsApp
// Business, X, LinkedIn, TikTok…). Access tokens are encrypted at rest; when no
// real provider is configured the account is a managed placeholder (see
// lib/social.js) so the workflow is fully usable without live API keys.
model SocialAccount {
  id            String   @id @default(uuid())
  tenantId      String
  platform      String // facebook | instagram | whatsapp | x | linkedin | tiktok | youtube
  handle        String
  displayName   String?
  status        String   @default("connected") // connected | disconnected | error
  followers     Int      @default(0)
  tokenCipher   String?
  tokenIv       String?
  tokenTag      String?
  connectedById String?
  meta          Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform, handle])
  @@index([tenantId, platform])
}

// A social post/campaign item, publishable to one or more platforms. Content
// often originates from Einstein (AI) or the Engagement Content Builder.
model SocialPost {
  id          String    @id @default(uuid())
  tenantId    String
  content     String
  mediaUrl    String?
  platforms   String[]  @default([])
  status      String    @default("draft") // draft | scheduled | publishing | published | failed
  source      String    @default("manual") // manual | einstein | engagement
  scheduledAt DateTime?
  publishedAt DateTime?
  authorId    String?
  authorName  String?
  results     Json      @default("{}") // per-platform outcome
  metrics     Json      @default("{}") // per-platform reach/likes/comments/shares
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, scheduledAt])
}

// An incoming social interaction (comment, mention, DM or review) that lands in
// the Engagement Inbox — where the team replies to grow engagement. Real when a
// platform API is connected; otherwise seeded with clearly-labelled samples.
model SocialEngagement {
  id           String    @id @default(uuid())
  tenantId     String
  platform     String // facebook | instagram | whatsapp | x | linkedin | tiktok | youtube
  kind         String    @default("comment") // comment | mention | dm | review
  authorName   String
  authorHandle String?
  text         String
  sentiment    String    @default("neutral") // positive | neutral | negative
  status       String    @default("new") // new | replied | archived
  replyText    String?
  repliedAt    DateTime?
  simulated    Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, platform])
}

// A daily follower count per platform — the time series behind the Growth page's
// following-growth trend. One row per (tenant, platform, day).
model SocialFollowerSnapshot {
  id        String   @id @default(uuid())
  tenantId  String
  platform  String
  followers Int      @default(0)
  day       String // YYYY-MM-DD (tenant-local day key)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, platform, day])
  @@index([tenantId, day])
}

// Generic industry-object store — the additive "custom object" engine that
// powers every industry vertical WITHOUT adding a table per industry and
// WITHOUT touching any core CRM model. Each row is one industry record
// (a telecom subscriber, a bank loan application, a hotel reservation, …),
// its shape defined by the industry registry (industries/registry.js).
model IndustryRecord {
  id         String   @id @default(uuid())
  tenantId   String
  industry   String // e.g. "telecom", "banking"
  objectType String // e.g. "subscriber", "loan_application"
  name       String // human label for the record
  stage      String? // pipeline stage (for pipeline objects)
  status     String   @default("active")
  amount     Float? // primary numeric (balance, loan value…)
  currency   String   @default("LRD") // local currency by default
  ownerId    String? // assigned user
  ownerName  String?
  data       Json     @default("{}") // all industry-specific fields
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, industry, objectType])
  @@index([tenantId, objectType, stage])
}

// Per-tenant monthly AI-assist consumption. One row per (tenant, month); the
// counter enforces the plan's AI allowance and resets naturally each period.
model AiUsage {
  id        String   @id @default(uuid())
  tenantId  String
  period    String // calendar month, "YYYY-MM"
  count     Int      @default(0)
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, period])
  @@index([tenantId])
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  passwordHash      String?
  employeeId        String?
  status            String    @default("active") // active | invited
  firstName         String
  lastName          String
  avatarUrl         String?
  department        String?
  jobTitle          String?
  phone             String?
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  mfaEnabled        Boolean   @default(false)
  mfaSecret         String? // TOTP secret (base32); set during enrollment
  passwordChangedAt DateTime?

  // ── Identity federation ────────────────────────────────────────────────
  // externalId  — the IdP's stable id for this user (SCIM "externalId").
  // ssoSubject  — the subject claim / NameID seen at SSO login.
  // provisionedVia — "manual" | "signup" | "sso" | "scim" (audit + safety: SCIM
  //                  only hard-manages the accounts it created).
  externalId     String?
  ssoSubject     String?
  provisionedVia String  @default("manual")

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Dashboard back-relations
  crmTasks         CrmTask[]
  crmFollowUps     CrmFollowUp[]
  crmOpportunities CrmOpportunity[]
  crmServiceUsages CrmServiceUsage[]
  marketingTodos   MarketingTodo[]
  scheduleEvents   MarketingScheduleEvent[]
  activities       MarketingActivity[]
  sessions         UserSession[]
  auditLogs        AuditLog[]
  rewardEvents     RewardEvent[]
  rewardStat       RewardStat?
  reports          Report[]

  @@unique([tenantId, employeeId])
  @@unique([tenantId, externalId])
  @@index([tenantId, ssoSubject])
}

model UserSession {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  ipAddress String?
  userAgent String?
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  isActive  Boolean   @default(true)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  action     String
  resource   String?
  resourceId String?
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Role {
  id   String @id @default(uuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model Contact {
  id    String @id @default(uuid())
  name  String
  key   String @unique
  email String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// -- CRM Dashboard Models ------------------------------------------------------

model CrmTask {
  id                  String    @id @default(uuid())
  title               String
  task_type           String    @default("call") // call | email | meeting | follow_up | review
  status              String    @default("pending") // pending | in_progress | completed | cancelled
  priority            String    @default("medium") // low | medium | high | urgent
  due_date            DateTime?
  relatedCustomerName String?
  userId              String
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmTicket {
  id            String   @id @default(uuid())
  ticket_number String
  subject       String
  customer_name String
  category      String   @default("general")
  priority      String   @default("medium") // low | medium | high | urgent
  status        String   @default("open") // open | in_progress | pending | resolved | closed
  sla_status    String   @default("on_track") // on_track | at_risk | breached
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([ticket_number, tenantId])
}

model CrmFollowUp {
  id             String   @id @default(uuid())
  customer_name  String
  follow_up_type String // call | email | meeting
  status         String   @default("scheduled") // scheduled | completed | cancelled
  scheduled_date DateTime
  notes          String?
  userId         String
  tenantId       String
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmOpportunity {
  id          String   @id @default(uuid())
  name        String
  source      String? // Inbound | Outbound | Referral | Website | Event
  value       Float    @default(0)
  stage       String   @default("prospecting") // prospecting | qualification | proposal | negotiation | closed_won | closed_lost
  probability Int      @default(0)
  status      String   @default("active") // active | won | lost
  ownerId     String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User   @relation(fields: [ownerId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmServiceUsage {
  id                  String   @id @default(uuid())
  service_name        String
  service_title       String
  service_description String?
  service_icon        String?
  usage_count         Int      @default(1)
  userId              String
  tenantId            String
  lastUsedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([service_name, userId, tenantId])
}

// -- Marketing Dashboard Models ------------------------------------------------

model MarketingTodo {
  id          String    @id @default(uuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    String    @default("medium") // low | medium | high | urgent
  due_date    DateTime?
  userId      String
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingScheduleEvent {
  id         String    @id @default(uuid())
  title      String
  event_type String    @default("meeting") // meeting | campaign | deadline | review
  start_time DateTime
  end_time   DateTime?
  location   String?
  userId     String
  tenantId   String
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingActivity {
  id        String   @id @default(uuid())
  action    String
  target    String
  service   String // personalization | b2b | emma | creative
  userId    String
  tenantId  String
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// -- Network Dashboard Models --------------------------------------------------

model NetworkDevice {
  id             String   @id @default(uuid())
  hostname       String
  ip_address     String
  device_type    String   @default("server") // server | endpoint | router | switch | firewall | cloud
  status         String   @default("up") // up | down | degraded | maintenance
  os             String?
  cpu_util       Float    @default(0)
  mem_util       Float    @default(0)
  bandwidth_mbps Float    @default(0)
  region         String?
  cloud_provider String? // aws | azure | gcp | on_prem
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  alerts NetworkAlert[]
}

model NetworkAlert {
  id         String    @id @default(uuid())
  title      String
  message    String?
  severity   String    @default("info") // info | warning | critical
  status     String    @default("open") // open | acknowledged | resolved
  deviceId   String?
  tenantId   String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  device NetworkDevice? @relation(fields: [deviceId], references: [id])
  tenant Tenant         @relation(fields: [tenantId], references: [id])
}

model NetworkIncident {
  id          String    @id @default(uuid())
  title       String
  description String?
  severity    String    @default("medium") // low | medium | high | critical
  status      String    @default("open") // open | investigating | resolved | closed
  tenantId    String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkChange {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending") // pending | approved | rejected | completed
  priority    String   @default("medium") // low | medium | high | urgent
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkBackup {
  id          String   @id @default(uuid())
  device_name String
  backup_type String   @default("full") // full | incremental | differential
  status      String   @default("success") // success | failed | pending | running
  size_gb     Float    @default(0)
  tenantId    String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkServer {
  id          String   @id @default(uuid())
  name        String
  hostname    String
  ip_address  String
  os          String   @default("linux")
  cores       Int      @default(1)
  ram_gb      Float    @default(0)
  disk_gb     Float    @default(0)
  cpu_util    Float    @default(0)
  mem_util    Float    @default(0)
  disk_util   Float    @default(0)
  status      String   @default("online") // online | offline | maintenance | rebooting
  environment String   @default("prod") // prod | staging | dev | test
  region      String?
  tags        String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkUserRestriction {
  id             String   @id @default(uuid())
  name           String
  description    String?
  target_type    String   @default("user") // user | device | group | subnet
  target         String
  rule_type      String   @default("block") // block | allow | rate_limit | schedule
  protocol       String   @default("any") // tcp | udp | icmp | any
  port           String?
  direction      String   @default("both") // inbound | outbound | both
  priority       Int      @default(100)
  enabled        Boolean  @default(true)
  bandwidth_kbps Int?
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model FirewallRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  chain       String   @default("INPUT") // INPUT | OUTPUT | FORWARD
  action      String   @default("ACCEPT") // ACCEPT | DROP | REJECT | LOG
  protocol    String   @default("any") // tcp | udp | icmp | any
  src_ip      String?
  dst_ip      String?
  src_port    String?
  dst_port    String?
  zone_src    String?
  zone_dst    String?
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  log_traffic Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  name        String
  objective   String    @default("lead_generation")
  channel     String    @default("email")
  status      String    @default("draft")
  budget      Float     @default(0)
  spent       Float     @default(0)
  leads       Int       @default(0)
  clicks      Int       @default(0)
  opens       Int       @default(0)
  conversions Int       @default(0)
  revenue     Float     @default(0)
  ctr         Float?
  openRate    Float?
  roi         Float?
  startDate   DateTime?
  endDate     DateTime?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MarketingAudience {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("behavioral")
  size        Int      @default(0)
  status      String   @default("draft")
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingExperiment {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("a/b")
  status     String   @default("draft")
  metric     String   @default("conversion_rate")
  hypothesis String?
  variants   Json?
  result     String?
  confidence Float?
  lift       Float?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -- Services / Business Operations Models ------------------------------------

model BizTransaction {
  id          String   @id @default(uuid())
  type        String   @default("income") // income | expense
  category    String
  amount      Float
  description String?
  date        String
  status      String   @default("completed") // completed | pending | cancelled
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model BizTaxPlan {
  id                String   @id @default(uuid())
  title             String
  year              Int
  status            String   @default("active") // active | inactive | completed
  estimated_savings Float    @default(0)
  strategy          String?
  notes             String?
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  createdAt         DateTime @default(now())
}

model BizInvestment {
  id            String   @id @default(uuid())
  name          String
  type          String   @default("stocks") // stocks | bonds | real_estate | crypto | other
  initial_value Float    @default(0)
  current_value Float    @default(0)
  status        String   @default("active") // active | closed
  notes         String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model BizSOP {
  id          String   @id @default(uuid())
  title       String
  department  String
  description String?
  steps       Json     @default("[]")
  status      String   @default("active") // active | inactive | draft
  version     String   @default("1.0")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BizWorkflow {
  id           String   @id @default(uuid())
  name         String
  description  String?
  department   String?
  trigger      String?
  steps        Json     @default("[]")
  status       String   @default("active") // active | inactive
  is_automated Boolean  @default(false)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
}

model BizGoal {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("growth")
  description String?
  target_date String?
  progress    Int      @default(0)
  milestones  Json     @default("[]")
  status      String   @default("in_progress") // in_progress | completed | at_risk | planning
  priority    String   @default("medium")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BizMarketAnalysis {
  id            String   @id @default(uuid())
  title         String
  market        String
  analysis_type String   @default("competitive")
  summary       String?
  opportunities Json     @default("[]")
  threats       Json     @default("[]")
  status        String   @default("active")
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model BizCampaign {
  id          String   @id @default(uuid())
  name        String
  platform    String   @default("email")
  status      String   @default("draft") // draft | active | paused | completed
  budget      Float    @default(0)
  spent       Float    @default(0)
  leads       Int      @default(0)
  conversions Int      @default(0)
  start_date  String?
  end_date    String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BizClient {
  id           String   @id @default(uuid())
  name         String
  company      String?
  email        String?
  phone        String?
  annual_value Float    @default(0)
  status       String   @default("active") // active | inactive | prospect
  contract_end String?
  industry     String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
}

model BizMember {
  id         String   @id @default(uuid())
  name       String
  role       String
  department String
  email      String?
  status     String   @default("active") // active | inactive
  skills     Json     @default("[]")
  avatar_url String?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
}

model BizProject {
  id           String   @id @default(uuid())
  name         String
  description  String?
  status       String   @default("planning") // planning | in_progress | review | completed
  priority     String   @default("medium")
  progress     Int      @default(0)
  budget       Float    @default(0)
  team_members Json     @default("[]")
  start_date   String?
  end_date     String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BizTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  project_id  String?
  status      String   @default("todo") // todo | in_progress | review | done
  priority    String   @default("medium")
  assignee    String?
  due_date    String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeptMessage {
  id         String   @id @default(uuid())
  tenantId   String
  authorId   String
  authorName String
  fromDept   String // canonical department key of the sender
  toDept     String? // null = all departments / company-wide
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model IntegrationConnection {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  kind         String    @default("api") // api | webhook | slack | custom
  baseUrl      String
  authType     String    @default("bearer") // bearer | header | none
  authHeader   String? // header name when authType = header
  secretCipher String? // AES-256-GCM ciphertext (never plaintext)
  secretIv     String?
  secretTag    String?
  secretLast4  String? // last 4 chars, for display only
  status       String    @default("active") // active | disabled
  lastUsedAt   DateTime?
  lastStatus   String? // outcome of the last call/test
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model NetworkAutomationJob {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String    @default("manual") // schedule | event | manual | webhook
  targets     String?
  steps       Json      @default("[]")
  status      String    @default("pending") // pending | queued | running | success | failed
  lastRun     DateTime?
  duration    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String // recipient
  type      String    @default("message") // message | dept_message | email | system
  title     String
  body      String?
  link      String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
}

model DirectMessage {
  id          String    @id @default(uuid())
  tenantId    String
  senderId    String
  senderName  String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, senderId, recipientId, createdAt])
  @@index([tenantId, recipientId, readAt])
}

model EmailLog {
  id          String   @id @default(uuid())
  tenantId    String
  toEmail     String
  fromEmail   String?
  subject     String
  status      String   @default("queued") // sent | failed | skipped
  provider    String   @default("resend")
  providerId  String?
  error       String?
  context     String? // marketing:campaign | crm:contact | auth:invite ...
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ── Attachments (generic, cross-module) ───────────────────────────────────────
// Files live in object storage; only metadata + URL are persisted here.
model Attachment {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String // deal | lead | task | project | campaign
  entityId     String
  fileName     String
  mimeType     String?
  size         Int      @default(0)
  url          String
  uploadedById String?
  uploaderName String?
  createdAt    DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

// Processed Stripe webhook event ids — makes webhook handling idempotent
// (Stripe retries deliveries; each event must apply exactly once).
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// ── CRM: cadences, playbooks, board resolutions (formerly canned stubs) ──────
model CrmSequence {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  steps       Int      @default(1)
  enrolled    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model CrmPlaybook {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String    @default("general")
  steps       Int       @default(1)
  active      Boolean   @default(true)
  runs        Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model CrmResolution {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  category    String   @default("Governance")
  status      String   @default("under_review") // under_review | approved | rejected
  votes       Int      @default(0)
  createdAt   DateTime @default(now())

  ballots CrmResolutionVote[]

  @@index([tenantId])
}

// One ballot per user per resolution (the PK enforces it).
model CrmResolutionVote {
  resolutionId String
  userId       String
  createdAt    DateTime @default(now())

  resolution CrmResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@id([resolutionId, userId])
}

// Per-user notification delivery preferences (the toggles in Account).
model NotificationPref {
  userId    String   @id
  tenantId  String
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  inApp     Boolean  @default(true)
  digest    String   @default("daily") // realtime | daily | weekly | off
  updatedAt DateTime @updatedAt
}

// ── Reward system ────────────────────────────────────────────────────────────
// Append-only ledger of point-earning actions. Every navigation, workspace
// action and completed piece of work lands here; RewardStat is the running
// rollup so the leaderboard stays a single cheap read. Both carry tenantId, so
// the isolation guard scopes them automatically.
model RewardEvent {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  category  String // navigation | usage | performance | milestone
  type      String // e.g. "visit:/crm", "create:crm", "update:marketing"
  points    Int
  detail    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, type, createdAt])
}

// Running per-user rollup — points, category breakdown, activity streak. One
// row per user per tenant; updated in the same request that records an event.
model RewardStat {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String   @unique
  points        Int      @default(0)
  navPoints     Int      @default(0)
  usagePoints   Int      @default(0)
  perfPoints    Int      @default(0)
  eventsCount   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDay String? // "YYYY-MM-DD" (UTC)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, points])
}

// ── Enterprise identity federation (SSO + SCIM) ──────────────────────────────
// One identity provider per organization. Covers both protocols enterprises
// actually use: OIDC (Okta/Entra/Google/Auth0) and SAML 2.0. Client secrets and
// SP private keys are encrypted at rest (AES-GCM, lib/secrets) — the database
// never holds plaintext credentials and they are never returned to the client.
model SsoConnection {
  id       String  @id @default(uuid())
  tenantId String  @unique
  protocol String // oidc | saml
  enabled  Boolean @default(false)
  // Enforced ⇒ password login is refused for this org (SSO is the only way in).
  // Admins keep a password fallback so a broken IdP can never lock everyone out.
  enforced Boolean @default(false)

  displayName String? // button label, e.g. "Log in with Okta"
  // Email domains routed to this IdP (used by SSO discovery on the login page).
  domains     String[] @default([])

  // Just-in-time provisioning: create the user on first successful SSO login.
  jitProvisioning   Boolean @default(true)
  defaultRoleId     String?
  defaultDepartment String?

  // ── OIDC ──
  issuer             String?
  clientId           String?
  clientSecretCipher String?
  clientSecretIv     String?
  clientSecretTag    String?
  authorizationUrl   String?
  tokenUrl           String?
  jwksUrl            String?
  userinfoUrl        String?
  endSessionUrl      String?
  scopes             String  @default("openid email profile")

  // ── SAML 2.0 ──
  entryPoint         String? // IdP SSO URL
  idpIssuer          String? // IdP entityID
  idpCert            String? // IdP x509 signing certificate (base64/PEM)
  logoutUrl          String? // IdP SLO endpoint
  signRequests       Boolean @default(false)
  spCertificate      String?
  spKeyCipher        String?
  spKeyIv            String?
  spKeyTag           String?
  signatureAlgorithm String  @default("sha256")

  // ── Attribute mapping (IdP claim/attribute → ExecUI field) ──
  attrEmail      String  @default("email")
  attrFirstName  String  @default("given_name")
  attrLastName   String  @default("family_name")
  attrExternalId String?
  attrGroups     String?
  // Optional IdP group → role name mapping, e.g. {"Admins":"enterprise_admin"}.
  groupRoleMap   Json    @default("{}")

  lastLoginAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Bearer token an IdP uses to call the SCIM 2.0 API. Only the SHA-256 hash is
// stored — the plaintext is shown exactly once, at creation.
model ScimToken {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique
  last4       String
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Short-lived, single-use record of an in-flight SSO login. Carries the OIDC
// nonce + PKCE verifier and the SAML AuthnRequest id, so callbacks can be bound
// to a request we actually started (CSRF + replay protection).
model SsoLoginRequest {
  id           String    @id @default(uuid())
  tenantId     String
  protocol     String
  nonce        String?
  codeVerifier String?
  requestId    String?
  redirectTo   String?
  ipAddress    String?
  // After a valid assertion we mint a single-use handoff code and redirect the
  // browser with THAT, not the JWT — so the session token never lands in
  // browser history, referrers or server logs. The SPA exchanges it once.
  userId       String?
  handoffCode  String?   @unique
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
}

// ── Custom reporting (BI) ────────────────────────────────────────────────────
// A saved report definition. `dataset` names an entry in the report dataset
// registry and `definition` holds the (validated) field/filter/grouping spec —
// never raw SQL, so a saved report can't become an injection vector.
model Report {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  dataset     String
  definition  Json     @default("{}")
  shared      Boolean  @default(true) // visible org-wide vs. only the author
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  schedules ReportSchedule[]

  @@index([tenantId])
}

// A recurring delivery of a report: render to CSV/XLSX/PDF and email it to the
// recipients on a cadence. nextRunAt is the scheduler's work queue.
model ReportSchedule {
  id          String    @id @default(uuid())
  tenantId    String
  reportId    String
  format      String    @default("csv") // csv | xlsx | pdf
  frequency   String    @default("weekly") // daily | weekly | monthly
  hour        Int       @default(7) // local hour in `timezone`
  minute      Int       @default(0)
  weekday     Int? // 0=Sun..6=Sat, for weekly
  dayOfMonth  Int? // 1..28, for monthly
  timezone    String    @default("UTC") // IANA zone the hour/minute is expressed in
  recipients  String[]  @default([])
  active      Boolean   @default(true)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  lastStatus  String? // sent | skipped | failed
  lastError   String?
  runCount    Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([active, nextRunAt])
}

// ── Public API & outbound webhooks ───────────────────────────────────────────
// A machine credential other systems use to call ExecUI. Only a SHA-256 hash is
// stored — the plaintext is shown once at creation and can never be recovered.
model ApiToken {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique // sha256(token) — the lookup key
  prefix      String // "execui_live_ab12…" shown in the UI for identification
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  lastUsedIp  String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tokenHash])
}

// A customer-registered HTTPS endpoint that receives signed event callbacks.
model WebhookEndpoint {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  description   String?
  events        String[]  @default([]) // subscribed event types; ["*"] = all
  secret        String // signing secret (shown once, used for HMAC)
  active        Boolean   @default(true)
  failureCount  Int       @default(0) // consecutive failures
  disabledAt    DateTime? // auto-disabled after repeated failures
  lastStatus    String?
  lastAttemptAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// One attempt-tracked delivery of one event to one endpoint. Retried with
// exponential backoff; kept as an auditable log the customer can inspect/replay.
model WebhookDelivery {
  id             String    @id @default(uuid())
  tenantId       String
  endpointId     String
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
}

// ── Workflow automation & approvals ──────────────────────────────────────────
// "When X happens, do Y." Triggered by domain events (the same stream that
// drives outbound webhooks), so a rule fires whether the change came from the
// UI, the public API or a background job. Conditions and actions are validated
// JSON specs — never executable code — so a rule can't become an injection path.
model Workflow {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  triggerEvent  String // e.g. "opportunities.updated"
  match         String    @default("all") // all | any
  conditions    Json      @default("[]")
  actions       Json      @default("[]")
  oncePerRecord Boolean   @default(false) // don't re-fire for a record already handled
  active        Boolean   @default(true)
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  lastStatus    String? // success | failed | skipped
  lastError     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@index([tenantId])
  @@index([tenantId, triggerEvent, active])
}

// One execution of one workflow — the audit trail that makes automation
// trustworthy: what fired, on which record, what each action did.
model WorkflowRun {
  id         String   @id @default(uuid())
  tenantId   String
  workflowId String
  event      String
  recordId   String?
  status     String   @default("success") // success | failed | skipped
  matched    Boolean  @default(true)
  results    Json     @default("[]") // per-action outcome
  error      String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([workflowId, recordId])
}

// A multi-step sign-off on a record. Steps are resolved to real approvers at
// request time and progressed one at a time; any rejection ends the chain.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  resource      String? // registry resource id, when attached to a record
  recordId      String?
  recordLabel   String?
  summary       String?
  status        String    @default("pending") // pending | approved | rejected | cancelled
  steps         Json      @default("[]") // [{ name, approverIds[], requiredCount, status }]
  currentStep   Int       @default(0)
  onApprove     Json      @default("[]") // actions to run when fully approved
  workflowId    String? // set when raised by a workflow
  requestedById String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ApprovalDecision {
  id        String   @id @default(uuid())
  tenantId  String
  requestId String
  stepIndex Int
  userId    String
  userName  String?
  decision  String // approve | reject
  comment   String?
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepIndex, userId])
  @@index([tenantId])
}
