// Prisma schema - ExecUI
// learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
   binaryTargets = ["native", "debian-openssl-1.1.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -- Core multi-tenant models --------------------------------------------------

model Tenant {
  id                String   @id @default(uuid())
  name              String
  slug              String   @unique
  code              String?  @unique
  createdAt         DateTime @default(now())
  stripeCustomerId  String?
  stripePlanId      String?
  stripeSubId       String?

  users            User[]
  roles            Role[]
  contacts         Contact[]
  crmTasks         CrmTask[]
  crmTickets       CrmTicket[]
  crmFollowUps     CrmFollowUp[]
  crmOpportunities CrmOpportunity[]
  crmServiceUsages CrmServiceUsage[]
  marketingTodos   MarketingTodo[]
  scheduleEvents   MarketingScheduleEvent[]
  activities       MarketingActivity[]
  campaigns        MarketingCampaign[]
  audiences        MarketingAudience[]
  experiments      MarketingExperiment[]
  bizTransactions  BizTransaction[]
  bizTaxPlans      BizTaxPlan[]
  bizInvestments   BizInvestment[]
  bizSOPs          BizSOP[]
  bizWorkflows     BizWorkflow[]
  bizGoals         BizGoal[]
  bizMarketAnalysis BizMarketAnalysis[]
  bizCampaigns     BizCampaign[]
  bizClients       BizClient[]
  bizMembers       BizMember[]
  bizProjects      BizProject[]
  bizTasks         BizTask[]
  networkDevices          NetworkDevice[]
  networkAlerts           NetworkAlert[]
  networkIncidents        NetworkIncident[]
  networkChanges          NetworkChange[]
  networkBackups          NetworkBackup[]
  networkServers          NetworkServer[]
  networkUserRestrictions NetworkUserRestriction[]
  firewallRules           FirewallRule[]
  userSessions            UserSession[]
  auditLogs               AuditLog[]
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String?
  employeeId   String?
  status       String   @default("active") // active | invited
  firstName    String
  lastName     String
  avatarUrl    String?
  department   String?
  jobTitle     String?
  phone        String?
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now())

  // Dashboard back-relations
  crmTasks         CrmTask[]
  crmFollowUps     CrmFollowUp[]
  crmOpportunities CrmOpportunity[]
  crmServiceUsages CrmServiceUsage[]
  marketingTodos   MarketingTodo[]
  scheduleEvents   MarketingScheduleEvent[]
  activities       MarketingActivity[]
  sessions         UserSession[]
  auditLogs        AuditLog[]

  @@unique([tenantId, employeeId])
}

model UserSession {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  ipAddress   String?
  userAgent   String?
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  isActive    Boolean   @default(true)
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  action     String
  resource   String?
  resourceId String?
  detail     String?
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Role {
  id   String @id @default(uuid())
  name String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  rolePermissions RolePermission[]
  users           User[]
}

model Permission {
  id          String   @id @default(uuid())
  key         String   @unique
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model Contact {
  id    String @id @default(uuid())
  name  String
  key   String @unique
  email String

  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

// -- CRM Dashboard Models ------------------------------------------------------

model CrmTask {
  id                  String    @id @default(uuid())
  title               String
  task_type           String    @default("call")   // call | email | meeting | follow_up | review
  status              String    @default("pending") // pending | in_progress | completed | cancelled
  priority            String    @default("medium")  // low | medium | high | urgent
  due_date            DateTime?
  relatedCustomerName String?
  userId              String
  tenantId            String
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmTicket {
  id            String   @id @default(uuid())
  ticket_number String
  subject       String
  customer_name String
  category      String   @default("general")
  priority      String   @default("medium") // low | medium | high | urgent
  status        String   @default("open")   // open | in_progress | pending | resolved | closed
  sla_status    String   @default("on_track") // on_track | at_risk | breached
  tenantId      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([ticket_number, tenantId])
}

model CrmFollowUp {
  id             String   @id @default(uuid())
  customer_name  String
  follow_up_type String   // call | email | meeting
  status         String   @default("scheduled") // scheduled | completed | cancelled
  scheduled_date DateTime
  notes          String?
  userId         String
  tenantId       String
  createdAt      DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmOpportunity {
  id          String   @id @default(uuid())
  name        String
  value       Float    @default(0)
  stage       String   @default("prospecting") // prospecting | qualification | proposal | negotiation | closed_won | closed_lost
  probability Int      @default(0)
  status      String   @default("active") // active | won | lost
  ownerId     String
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner  User   @relation(fields: [ownerId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model CrmServiceUsage {
  id                  String   @id @default(uuid())
  service_name        String
  service_title       String
  service_description String?
  service_icon        String?
  usage_count         Int      @default(1)
  userId              String
  tenantId            String
  lastUsedAt          DateTime @default(now())
  createdAt           DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([service_name, userId, tenantId])
}

// -- Marketing Dashboard Models ------------------------------------------------

model MarketingTodo {
  id          String    @id @default(uuid())
  title       String
  description String?
  completed   Boolean   @default(false)
  priority    String    @default("medium") // low | medium | high | urgent
  due_date    DateTime?
  userId      String
  tenantId    String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingScheduleEvent {
  id         String    @id @default(uuid())
  title      String
  event_type String    @default("meeting") // meeting | campaign | deadline | review
  start_time DateTime
  end_time   DateTime?
  location   String?
  userId     String
  tenantId   String
  createdAt  DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingActivity {
  id        String   @id @default(uuid())
  action    String
  target    String
  service   String   // personalization | b2b | emma | creative
  userId    String
  tenantId  String
  timestamp DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id])
  tenant Tenant @relation(fields: [tenantId], references: [id])
}

// -- Network Dashboard Models --------------------------------------------------

model NetworkDevice {
  id             String   @id @default(uuid())
  hostname       String
  ip_address     String
  device_type    String   @default("server")    // server | endpoint | router | switch | firewall | cloud
  status         String   @default("up")         // up | down | degraded | maintenance
  os             String?
  cpu_util       Float    @default(0)
  mem_util       Float    @default(0)
  bandwidth_mbps Float    @default(0)
  region         String?
  cloud_provider String?                          // aws | azure | gcp | on_prem
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant         @relation(fields: [tenantId], references: [id])
  alerts NetworkAlert[]
}

model NetworkAlert {
  id         String    @id @default(uuid())
  title      String
  message    String?
  severity   String    @default("info")  // info | warning | critical
  status     String    @default("open")  // open | acknowledged | resolved
  deviceId   String?
  tenantId   String
  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  device NetworkDevice? @relation(fields: [deviceId], references: [id])
  tenant Tenant         @relation(fields: [tenantId], references: [id])
}

model NetworkIncident {
  id          String    @id @default(uuid())
  title       String
  description String?
  severity    String    @default("medium") // low | medium | high | critical
  status      String    @default("open")   // open | investigating | resolved | closed
  tenantId    String
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkChange {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("pending") // pending | approved | rejected | completed
  priority    String   @default("medium")  // low | medium | high | urgent
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkBackup {
  id          String   @id @default(uuid())
  device_name String
  backup_type String   @default("full") // full | incremental | differential
  status      String   @default("success") // success | failed | pending | running
  size_gb     Float    @default(0)
  tenantId    String
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkServer {
  id          String   @id @default(uuid())
  name        String
  hostname    String
  ip_address  String
  os          String   @default("linux")
  cores       Int      @default(1)
  ram_gb      Float    @default(0)
  disk_gb     Float    @default(0)
  cpu_util    Float    @default(0)
  mem_util    Float    @default(0)
  disk_util   Float    @default(0)
  status      String   @default("online")  // online | offline | maintenance | rebooting
  environment String   @default("prod")    // prod | staging | dev | test
  region      String?
  tags        String?
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model NetworkUserRestriction {
  id             String   @id @default(uuid())
  name           String
  description    String?
  target_type    String   @default("user")      // user | device | group | subnet
  target         String
  rule_type      String   @default("block")     // block | allow | rate_limit | schedule
  protocol       String   @default("any")       // tcp | udp | icmp | any
  port           String?
  direction      String   @default("both")      // inbound | outbound | both
  priority       Int      @default(100)
  enabled        Boolean  @default(true)
  bandwidth_kbps Int?
  tenantId       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model FirewallRule {
  id          String   @id @default(uuid())
  name        String
  description String?
  chain       String   @default("INPUT")    // INPUT | OUTPUT | FORWARD
  action      String   @default("ACCEPT")   // ACCEPT | DROP | REJECT | LOG
  protocol    String   @default("any")      // tcp | udp | icmp | any
  src_ip      String?
  dst_ip      String?
  src_port    String?
  dst_port    String?
  zone_src    String?
  zone_dst    String?
  priority    Int      @default(100)
  enabled     Boolean  @default(true)
  log_traffic Boolean  @default(false)
  tenantId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

model MarketingCampaign {
  id          String    @id @default(uuid())
  name        String
  objective   String    @default("lead_generation")
  channel     String    @default("email")
  status      String    @default("draft")
  budget      Float     @default(0)
  spent       Float     @default(0)
  leads       Int       @default(0)
  clicks      Int       @default(0)
  opens       Int       @default(0)
  conversions Int       @default(0)
  revenue     Float     @default(0)
  ctr         Float?
  openRate    Float?
  roi         Float?
  startDate   DateTime?
  endDate     DateTime?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model MarketingAudience {
  id          String   @id @default(uuid())
  name        String
  type        String   @default("behavioral")
  size        Int      @default(0)
  status      String   @default("draft")
  description String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketingExperiment {
  id         String   @id @default(uuid())
  name       String
  type       String   @default("a/b")
  status     String   @default("draft")
  metric     String   @default("conversion_rate")
  hypothesis String?
  variants   Json?
  result     String?
  confidence Float?
  lift       Float?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// -- Services / Business Operations Models ------------------------------------

model BizTransaction {
  id          String   @id @default(uuid())
  type        String   @default("income")   // income | expense
  category    String
  amount      Float
  description String?
  date        String
  status      String   @default("completed") // completed | pending | cancelled
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
}

model BizTaxPlan {
  id                 String   @id @default(uuid())
  title              String
  year               Int
  status             String   @default("active") // active | inactive | completed
  estimated_savings  Float    @default(0)
  strategy           String?
  notes              String?
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  createdAt          DateTime @default(now())
}

model BizInvestment {
  id            String   @id @default(uuid())
  name          String
  type          String   @default("stocks") // stocks | bonds | real_estate | crypto | other
  initial_value Float    @default(0)
  current_value Float    @default(0)
  status        String   @default("active") // active | closed
  notes         String?
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model BizSOP {
  id          String   @id @default(uuid())
  title       String
  department  String
  description String?
  steps       Json     @default("[]")
  status      String   @default("active") // active | inactive | draft
  version     String   @default("1.0")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BizWorkflow {
  id           String   @id @default(uuid())
  name         String
  description  String?
  department   String?
  trigger      String?
  steps        Json     @default("[]")
  status       String   @default("active") // active | inactive
  is_automated Boolean  @default(false)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
}

model BizGoal {
  id          String   @id @default(uuid())
  title       String
  category    String   @default("growth")
  description String?
  target_date String?
  progress    Int      @default(0)
  milestones  Json     @default("[]")
  status      String   @default("in_progress") // in_progress | completed | at_risk | planning
  priority    String   @default("medium")
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BizMarketAnalysis {
  id            String   @id @default(uuid())
  title         String
  market        String
  analysis_type String   @default("competitive")
  summary       String?
  opportunities Json     @default("[]")
  threats       Json     @default("[]")
  status        String   @default("active")
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  createdAt     DateTime @default(now())
}

model BizCampaign {
  id          String    @id @default(uuid())
  name        String
  platform    String    @default("email")
  status      String    @default("draft")   // draft | active | paused | completed
  budget      Float     @default(0)
  spent       Float     @default(0)
  leads       Int       @default(0)
  conversions Int       @default(0)
  start_date  String?
  end_date    String?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model BizClient {
  id           String   @id @default(uuid())
  name         String
  company      String?
  email        String?
  phone        String?
  annual_value Float    @default(0)
  status       String   @default("active") // active | inactive | prospect
  contract_end String?
  industry     String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
}

model BizMember {
  id         String   @id @default(uuid())
  name       String
  role       String
  department String
  email      String?
  status     String   @default("active") // active | inactive
  skills     Json     @default("[]")
  avatar_url String?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
}

model BizProject {
  id           String    @id @default(uuid())
  name         String
  description  String?
  status       String    @default("planning") // planning | in_progress | review | completed
  priority     String    @default("medium")
  progress     Int       @default(0)
  budget       Float     @default(0)
  team_members Json      @default("[]")
  start_date   String?
  end_date     String?
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id])
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model BizTask {
  id          String    @id @default(uuid())
  title       String
  description String?
  project_id  String?
  status      String    @default("todo")    // todo | in_progress | review | done
  priority    String    @default("medium")
  assignee    String?
  due_date    String?
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model DeptMessage {
  id         String   @id @default(uuid())
  tenantId   String
  authorId   String
  authorName String
  fromDept   String                       // canonical department key of the sender
  toDept     String?                       // null = all departments / company-wide
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model ApiKey {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  prefix      String                       // shown for identification, e.g. exk_live_Xy7d…
  hash        String    @unique            // sha256 of the full key (plaintext is never stored)
  scopes      String[]  @default([])       // e.g. ["read","write"]
  lastUsedAt  DateTime?
  lastUsedIp  String?
  createdById String?
  revokedAt   DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}
