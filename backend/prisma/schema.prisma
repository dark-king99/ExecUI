  name       String
  role       String
  department String
  email      String?
  status     String   @default("active") // active | inactive
  skills     Json     @default("[]")
  avatar_url String?
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id])
  createdAt  DateTime @default(now())
}

model BizProject {
  id           String   @id @default(uuid())
  name         String
  description  String?
  status       String   @default("planning") // planning | in_progress | review | completed
  priority     String   @default("medium")
  progress     Int      @default(0)
  budget       Float    @default(0)
  team_members Json     @default("[]")
  start_date   String?
  end_date     String?
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model BizTask {
  id          String   @id @default(uuid())
  title       String
  description String?
  project_id  String?
  status      String   @default("todo") // todo | in_progress | review | done
  priority    String   @default("medium")
  assignee    String?
  due_date    String?
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DeptMessage {
  id         String   @id @default(uuid())
  tenantId   String
  authorId   String
  authorName String
  fromDept   String // canonical department key of the sender
  toDept     String? // null = all departments / company-wide
  body       String
  createdAt  DateTime @default(now())

  @@index([tenantId, createdAt])
}

model IntegrationConnection {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  kind         String    @default("api") // api | webhook | slack | custom
  baseUrl      String
  authType     String    @default("bearer") // bearer | header | none
  authHeader   String? // header name when authType = header
  secretCipher String? // AES-256-GCM ciphertext (never plaintext)
  secretIv     String?
  secretTag    String?
  secretLast4  String? // last 4 chars, for display only
  status       String    @default("active") // active | disabled
  lastUsedAt   DateTime?
  lastStatus   String? // outcome of the last call/test
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([tenantId])
}

model NetworkAutomationJob {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  trigger     String    @default("manual") // schedule | event | manual | webhook
  targets     String?
  steps       Json      @default("[]")
  status      String    @default("pending") // pending | queued | running | success | failed
  lastRun     DateTime?
  duration    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
}

model Notification {
  id        String    @id @default(uuid())
  tenantId  String
  userId    String // recipient
  type      String    @default("message") // message | dept_message | email | system
  title     String
  body      String?
  link      String?
  actorName String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([tenantId, userId, createdAt])
}

model DirectMessage {
  id          String    @id @default(uuid())
  tenantId    String
  senderId    String
  senderName  String
  recipientId String
  body        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId, senderId, recipientId, createdAt])
  @@index([tenantId, recipientId, readAt])
}

model EmailLog {
  id          String   @id @default(uuid())
  tenantId    String
  toEmail     String
  fromEmail   String?
  subject     String
  status      String   @default("queued") // sent | failed | skipped
  provider    String   @default("resend")
  providerId  String?
  error       String?
  context     String? // marketing:campaign | crm:contact | auth:invite ...
  createdById String?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
}

// ── Attachments (generic, cross-module) ───────────────────────────────────────
// Files live in object storage; only metadata + URL are persisted here.
model Attachment {
  id           String   @id @default(uuid())
  tenantId     String
  entityType   String // deal | lead | task | project | campaign
  entityId     String
  fileName     String
  mimeType     String?
  size         Int      @default(0)
  url          String
  uploadedById String?
  uploaderName String?
  createdAt    DateTime @default(now())

  @@index([tenantId, entityType, entityId])
}

// Processed Stripe webhook event ids — makes webhook handling idempotent
// (Stripe retries deliveries; each event must apply exactly once).
model WebhookEvent {
  id        String   @id
  type      String
  createdAt DateTime @default(now())
}

// ── CRM: cadences, playbooks, board resolutions (formerly canned stubs) ──────
model CrmSequence {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  steps       Int      @default(1)
  enrolled    Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([tenantId])
}

model CrmPlaybook {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String    @default("general")
  steps       Int       @default(1)
  active      Boolean   @default(true)
  runs        Int       @default(0)
  lastRunAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}

model CrmResolution {
  id          String   @id @default(uuid())
  tenantId    String
  title       String
  description String?
  category    String   @default("Governance")
  status      String   @default("under_review") // under_review | approved | rejected
  votes       Int      @default(0)
  createdAt   DateTime @default(now())

  ballots CrmResolutionVote[]

  @@index([tenantId])
}

// One ballot per user per resolution (the PK enforces it).
model CrmResolutionVote {
  resolutionId String
  userId       String
  createdAt    DateTime @default(now())

  resolution CrmResolution @relation(fields: [resolutionId], references: [id], onDelete: Cascade)

  @@id([resolutionId, userId])
}

// Per-user notification delivery preferences (the toggles in Account).
model NotificationPref {
  userId    String   @id
  tenantId  String
  email     Boolean  @default(true)
  sms       Boolean  @default(false)
  inApp     Boolean  @default(true)
  digest    String   @default("daily") // realtime | daily | weekly | off
  updatedAt DateTime @updatedAt
}

// ── Reward system ────────────────────────────────────────────────────────────
// Append-only ledger of point-earning actions. Every navigation, workspace
// action and completed piece of work lands here; RewardStat is the running
// rollup so the leaderboard stays a single cheap read. Both carry tenantId, so
// the isolation guard scopes them automatically.
model RewardEvent {
  id        String   @id @default(uuid())
  tenantId  String
  userId    String
  category  String // navigation | usage | performance | milestone
  type      String // e.g. "visit:/crm", "create:crm", "update:marketing"
  points    Int
  detail    String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId])
  @@index([tenantId, createdAt])
  @@index([tenantId, userId, type, createdAt])
}

// Running per-user rollup — points, category breakdown, activity streak. One
// row per user per tenant; updated in the same request that records an event.
model RewardStat {
  id            String   @id @default(uuid())
  tenantId      String
  userId        String   @unique
  points        Int      @default(0)
  navPoints     Int      @default(0)
  usagePoints   Int      @default(0)
  perfPoints    Int      @default(0)
  eventsCount   Int      @default(0)
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActiveDay String? // "YYYY-MM-DD" (UTC)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId])
  @@index([tenantId, points])
}

// ── Enterprise identity federation (SSO + SCIM) ──────────────────────────────
// One identity provider per organization. Covers both protocols enterprises
// actually use: OIDC (Okta/Entra/Google/Auth0) and SAML 2.0. Client secrets and
// SP private keys are encrypted at rest (AES-GCM, lib/secrets) — the database
// never holds plaintext credentials and they are never returned to the client.
model SsoConnection {
  id       String  @id @default(uuid())
  tenantId String  @unique
  protocol String // oidc | saml
  enabled  Boolean @default(false)
  // Enforced ⇒ password login is refused for this org (SSO is the only way in).
  // Admins keep a password fallback so a broken IdP can never lock everyone out.
  enforced Boolean @default(false)

  displayName String? // button label, e.g. "Log in with Okta"
  // Email domains routed to this IdP (used by SSO discovery on the login page).
  domains     String[] @default([])

  // Just-in-time provisioning: create the user on first successful SSO login.
  jitProvisioning   Boolean @default(true)
  defaultRoleId     String?
  defaultDepartment String?

  // ── OIDC ──
  issuer             String?
  clientId           String?
  clientSecretCipher String?
  clientSecretIv     String?
  clientSecretTag    String?
  authorizationUrl   String?
  tokenUrl           String?
  jwksUrl            String?
  userinfoUrl        String?
  endSessionUrl      String?
  scopes             String  @default("openid email profile")

  // ── SAML 2.0 ──
  entryPoint         String? // IdP SSO URL
  idpIssuer          String? // IdP entityID
  idpCert            String? // IdP x509 signing certificate (base64/PEM)
  logoutUrl          String? // IdP SLO endpoint
  signRequests       Boolean @default(false)
  spCertificate      String?
  spKeyCipher        String?
  spKeyIv            String?
  spKeyTag           String?
  signatureAlgorithm String  @default("sha256")

  // ── Attribute mapping (IdP claim/attribute → ExecUI field) ──
  attrEmail      String  @default("email")
  attrFirstName  String  @default("given_name")
  attrLastName   String  @default("family_name")
  attrExternalId String?
  attrGroups     String?
  // Optional IdP group → role name mapping, e.g. {"Admins":"enterprise_admin"}.
  groupRoleMap   Json    @default("{}")

  lastLoginAt DateTime?
  lastError   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// Bearer token an IdP uses to call the SCIM 2.0 API. Only the SHA-256 hash is
// stored — the plaintext is shown exactly once, at creation.
model ScimToken {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique
  last4       String
  createdById String?
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

// Short-lived, single-use record of an in-flight SSO login. Carries the OIDC
// nonce + PKCE verifier and the SAML AuthnRequest id, so callbacks can be bound
// to a request we actually started (CSRF + replay protection).
model SsoLoginRequest {
  id           String    @id @default(uuid())
  tenantId     String
  protocol     String
  nonce        String?
  codeVerifier String?
  requestId    String?
  redirectTo   String?
  ipAddress    String?
  // After a valid assertion we mint a single-use handoff code and redirect the
  // browser with THAT, not the JWT — so the session token never lands in
  // browser history, referrers or server logs. The SPA exchanges it once.
  userId       String?
  handoffCode  String?   @unique
  consumedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([expiresAt])
}

// ── Custom reporting (BI) ────────────────────────────────────────────────────
// A saved report definition. `dataset` names an entry in the report dataset
// registry and `definition` holds the (validated) field/filter/grouping spec —
// never raw SQL, so a saved report can't become an injection vector.
model Report {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  dataset     String
  definition  Json     @default("{}")
  shared      Boolean  @default(true) // visible org-wide vs. only the author
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)
  schedules ReportSchedule[]

  @@index([tenantId])
}

// A recurring delivery of a report: render to CSV/XLSX/PDF and email it to the
// recipients on a cadence. nextRunAt is the scheduler's work queue.
model ReportSchedule {
  id          String    @id @default(uuid())
  tenantId    String
  reportId    String
  format      String    @default("csv") // csv | xlsx | pdf
  frequency   String    @default("weekly") // daily | weekly | monthly
  hour        Int       @default(7) // local hour in `timezone`
  minute      Int       @default(0)
  weekday     Int? // 0=Sun..6=Sat, for weekly
  dayOfMonth  Int? // 1..28, for monthly
  timezone    String    @default("UTC") // IANA zone the hour/minute is expressed in
  recipients  String[]  @default([])
  active      Boolean   @default(true)
  nextRunAt   DateTime?
  lastRunAt   DateTime?
  lastStatus  String? // sent | skipped | failed
  lastError   String?
  runCount    Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([active, nextRunAt])
}

// ── Public API & outbound webhooks ───────────────────────────────────────────
// A machine credential other systems use to call ExecUI. Only a SHA-256 hash is
// stored — the plaintext is shown once at creation and can never be recovered.
model ApiToken {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  tokenHash   String    @unique // sha256(token) — the lookup key
  prefix      String // "execui_live_ab12…" shown in the UI for identification
  scopes      String[]  @default([])
  lastUsedAt  DateTime?
  lastUsedIp  String?
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([tokenHash])
}

// A customer-registered HTTPS endpoint that receives signed event callbacks.
model WebhookEndpoint {
  id            String    @id @default(uuid())
  tenantId      String
  url           String
  description   String?
  events        String[]  @default([]) // subscribed event types; ["*"] = all
  secret        String // signing secret (shown once, used for HMAC)
  active        Boolean   @default(true)
  failureCount  Int       @default(0) // consecutive failures
  disabledAt    DateTime? // auto-disabled after repeated failures
  lastStatus    String?
  lastAttemptAt DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([tenantId])
  @@index([tenantId, active])
}

// One attempt-tracked delivery of one event to one endpoint. Retried with
// exponential backoff; kept as an auditable log the customer can inspect/replay.
model WebhookDelivery {
  id             String    @id @default(uuid())
  tenantId       String
  endpointId     String
  event          String
  payload        Json
  status         String    @default("pending") // pending | delivered | failed
  attempts       Int       @default(0)
  responseStatus Int?
  responseBody   String?
  error          String?
  nextAttemptAt  DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([status, nextAttemptAt])
}

// ── Workflow automation & approvals ──────────────────────────────────────────
// "When X happens, do Y." Triggered by domain events (the same stream that
// drives outbound webhooks), so a rule fires whether the change came from the
// UI, the public API or a background job. Conditions and actions are validated
// JSON specs — never executable code — so a rule can't become an injection path.
model Workflow {
  id            String    @id @default(uuid())
  tenantId      String
  name          String
  description   String?
  triggerEvent  String // e.g. "opportunities.updated"
  match         String    @default("all") // all | any
  conditions    Json      @default("[]")
  actions       Json      @default("[]")
  oncePerRecord Boolean   @default(false) // don't re-fire for a record already handled
  active        Boolean   @default(true)
  runCount      Int       @default(0)
  lastRunAt     DateTime?
  lastStatus    String? // success | failed | skipped
  lastError     String?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  runs   WorkflowRun[]

  @@index([tenantId])
  @@index([tenantId, triggerEvent, active])
}

// One execution of one workflow — the audit trail that makes automation
// trustworthy: what fired, on which record, what each action did.
model WorkflowRun {
  id         String   @id @default(uuid())
  tenantId   String
  workflowId String
  event      String
  recordId   String?
  status     String   @default("success") // success | failed | skipped
  matched    Boolean  @default(true)
  results    Json     @default("[]") // per-action outcome
  error      String?
  durationMs Int      @default(0)
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([workflowId, recordId])
}

// A multi-step sign-off on a record. Steps are resolved to real approvers at
// request time and progressed one at a time; any rejection ends the chain.
model ApprovalRequest {
  id            String    @id @default(uuid())
  tenantId      String
  title         String
  resource      String? // registry resource id, when attached to a record
  recordId      String?
  recordLabel   String?
  summary       String?
  status        String    @default("pending") // pending | approved | rejected | cancelled
  steps         Json      @default("[]") // [{ name, approverIds[], requiredCount, status }]
  currentStep   Int       @default(0)
  onApprove     Json      @default("[]") // actions to run when fully approved
  workflowId    String? // set when raised by a workflow
  requestedById String?
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  decisions ApprovalDecision[]

  @@index([tenantId, status])
  @@index([tenantId, createdAt])
}

model ApprovalDecision {
  id        String   @id @default(uuid())
  tenantId  String
  requestId String
  stepIndex Int
  userId    String
  userName  String?
  decision  String // approve | reject
  comment   String?
  createdAt DateTime @default(now())

  tenant  Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@unique([requestId, stepIndex, userId])
  @@index([tenantId])
}

// ── Compliance & data governance ─────────────────────────────────────────────
// How long a category of data is kept before it is purged. `action` decides
// whether rows are deleted outright or anonymized — audit trails must survive
// as evidence, so they lose their PII rather than disappearing.
model RetentionPolicy {
  id          String    @id @default(uuid())
  tenantId    String
  category    String // registry category id
  retainDays  Int
  action      String    @default("delete") // delete | anonymize
  active      Boolean   @default(true)
  lastRunAt   DateTime?
  lastPurged  Int       @default(0)
  totalPurged Int       @default(0)
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, category])
  @@index([tenantId])
}

// A data-subject access request (GDPR Art. 15 export / Art. 17 erasure).
// The outcome is recorded permanently so the organization can evidence that it
// honored the request, and what exactly was done.
model DataRequest {
  id            String    @id @default(uuid())
  tenantId      String
  type          String // export | erase
  subjectType   String // employee | contact
  subjectId     String?
  subjectEmail  String
  subjectLabel  String?
  status        String    @default("pending") // pending | completed | failed | blocked
  result        Json      @default("{}") // export bundle or erasure summary
  recordCount   Int       @default(0)
  note          String?
  error         String?
  requestedById String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@index([tenantId, subjectEmail])
}

// Freezes data against erasure and retention purging — for litigation,
// investigation or audit. A hold always wins over a deletion request.
model LegalHold {
  id           String    @id @default(uuid())
  tenantId     String
  name         String
  reason       String?
  scope        String    @default("subject") // subject | category
  subjectEmail String? // when scope = subject
  category     String? // when scope = category
  active       Boolean   @default(true)
  placedById   String?
  releasedAt   DateTime?
  releasedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// ── Documents, e-signature & contract lifecycle (CLM) ────────────────────────
// A document is the *identity* of a file (its title, owner, category); the file
// itself always lives in a DocumentVersion. Uploading a replacement therefore
// adds a version rather than overwriting one — a signed contract can never be
// silently swapped for different text.
model Document {
  id             String   @id @default(uuid())
  tenantId       String
  title          String
  description    String?
  category       String   @default("general") // registry category id
  status         String   @default("active") // active | archived
  confidential   Boolean  @default(false)
  currentVersion Int      @default(0)
  tags           String[] @default([])
  // Optional link to the record this document belongs to (deal, project, …).
  entityType     String?
  entityId       String?
  templateId     String?
  ownerId        String?
  ownerName      String?
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant    Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  versions  DocumentVersion[]
  requests  SignatureRequest[]
  contracts Contract[]

  @@index([tenantId, status])
  @@index([tenantId, category])
  @@index([tenantId, entityType, entityId])
}

// One immutable revision of a document. `checksum` is the SHA-256 of the stored
// bytes — it's what a completion certificate binds a signature to, so a signed
// file can be proven to be the one that was signed.
model DocumentVersion {
  id           String   @id @default(uuid())
  tenantId     String
  documentId   String
  version      Int
  fileName     String
  mimeType     String?
  size         Int      @default(0)
  url          String
  checksum     String?
  notes        String?
  uploadedById String?
  uploaderName String?
  createdAt    DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, version])
  @@index([tenantId, documentId])
}

// A reusable document template. `body` carries {{placeholders}} rendered with the
// same prototype-safe templating the automation engine uses.
model DocumentTemplate {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  description String?
  category    String   @default("general")
  body        String
  variables   Json     @default("[]") // [{ key, label, required }]
  active      Boolean  @default(true)
  useCount    Int      @default(0)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// An e-signature envelope: one document version, one or more signers.
// `certificate` holds the tamper-evident completion record (see
// signatures.service.js) — hashes, timestamps and IPs, plus a hash over itself.
model SignatureRequest {
  id          String    @id @default(uuid())
  tenantId    String
  documentId  String
  versionId   String?
  title       String
  message     String?
  status      String    @default("draft") // draft | sent | completed | declined | cancelled | expired
  sequential  Boolean   @default(false)
  expiresAt   DateTime?
  sentAt      DateTime?
  completedAt DateTime?
  certificate Json?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document  Document         @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signers   Signer[]
  events    SignatureEvent[]
  contracts Contract[]

  @@index([tenantId, status])
}

// A party on an envelope. Only the SHA-256 of the emailed access token is
// stored, so the database can't be used to sign on someone else's behalf.
model Signer {
  id            String    @id @default(uuid())
  tenantId      String
  requestId     String
  name          String
  email         String
  role          String    @default("signer") // signer | approver | viewer
  order         Int       @default(0)
  status        String    @default("pending") // pending | sent | viewed | signed | declined
  tokenHash     String?
  userId        String?
  signatureName String? // typed legal name, the act of signing
  consent       Boolean   @default(false) // explicit intent to sign electronically
  ip            String?
  userAgent     String?
  viewedAt      DateTime?
  signedAt      DateTime?
  declineReason String?
  remindedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  events  SignatureEvent[]

  @@unique([requestId, email])
  @@index([tenantId, status])
  @@index([tokenHash])
}

// The signing audit trail — every state change, with who/when/where. Append-only
// by convention: nothing in the app updates or deletes these rows.
model SignatureEvent {
  id        String   @id @default(uuid())
  tenantId  String
  requestId String
  signerId  String?
  type      String // created | sent | reminded | viewed | signed | declined | completed | cancelled | expired
  detail    String?
  ip        String?
  userAgent String?
  actorName String?
  createdAt DateTime @default(now())

  tenant  Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  request SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  signer  Signer?          @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@index([tenantId, requestId, createdAt])
}

// A contract: the business agreement wrapped around a document, with dates,
// money and a lifecycle. Renewal fields drive the reminder scheduler.
model Contract {
  id                 String    @id @default(uuid())
  tenantId           String
  title              String
  counterparty       String
  type               String    @default("other") // registry contract type
  status             String    @default("draft") // registry lifecycle state
  value              Float     @default(0)
  currency           String    @default("USD")
  startDate          DateTime?
  endDate            DateTime?
  autoRenew          Boolean   @default(false)
  renewalTermMonths  Int?
  noticePeriodDays   Int       @default(30)
  renewalNotifiedAt  DateTime?
  expiryNotifiedAt   DateTime?
  documentId         String?
  approvalRequestId  String?
  signatureRequestId String?
  ownerId            String?
  ownerName          String?
  notes              String?
  terminatedAt       DateTime?
  renewedFromId      String?
  createdById        String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant    Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  document  Document?         @relation(fields: [documentId], references: [id], onDelete: SetNull)
  signature SignatureRequest? @relation(fields: [signatureRequestId], references: [id], onDelete: SetNull)
  events    ContractEvent[]
  // The renewal chain as a real relation, so "what did this replace?" and "what
  // replaced it?" are answerable in one query — and a renewal can't point at a
  // contract that no longer exists.
  renewedFrom Contract?       @relation("ContractRenewal", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewals    Contract[]      @relation("ContractRenewal")

  @@index([tenantId, status])
  @@index([tenantId, endDate])
  @@index([renewedFromId])
}

// The contract timeline — every lifecycle move, with who made it. This is the
// answer to "how did this contract get to be active?".
model ContractEvent {
  id         String   @id @default(uuid())
  tenantId   String
  contractId String
  type       String // created | updated | status | approval | signature | renewal | reminder | note
  detail     String?
  fromStatus String?
  toStatus   String?
  actorId    String?
  actorName  String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([tenantId, contractId, createdAt])
}

// ── HR / People Ops ──────────────────────────────────────────────────────────
// The employment facts about a person, kept OUT of User. User is an identity
// (can this person sign in?); employment is a separate, far more sensitive
// concern with its own access rules — mixing them would mean every route that
// reads a user could accidentally read someone's salary or bank details.
model EmploymentProfile {
  id       String @id @default(uuid())
  tenantId String
  userId   String @unique

  employmentType    String    @default("full_time") // full_time | part_time | contract | intern | temporary
  status            String    @default("active") // active | probation | on_leave | notice | terminated
  hireDate          DateTime?
  probationEndAt    DateTime?
  noticeGivenAt     DateTime?
  endDate           DateTime? // last day worked
  terminationReason String?
  workLocation      String? // office | remote | hybrid | free text
  managerId         String?
  costCenter        String?
  weeklyHours       Float?    @default(40)

  dateOfBirth       DateTime?
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?

  // Government ids and bank details are encrypted at rest (AES-256-GCM, the
  // same store used for integration secrets). Only the last few digits are
  // ever returned to a client, so the console can confirm "the right account"
  // without exposing it.
  taxIdCipher       String?
  taxIdIv           String?
  taxIdTag          String?
  taxIdLast4        String?
  nationalIdCipher  String?
  nationalIdIv      String?
  nationalIdTag     String?
  nationalIdLast4   String?
  bankName          String?
  bankAccountCipher String?
  bankAccountIv     String?
  bankAccountTag    String?
  bankAccountLast4  String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, managerId])
}

// A compensation record is a *version*, never an edit. Payroll always resolves
// "what was this person paid as of this date", so a raise adds a row and the
// history stays auditable — the same reasoning as document versions.
model Compensation {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  effectiveFrom DateTime
  payType       String   @default("salary") // salary | hourly
  baseAmount    Float // annual salary, or hourly rate
  currency      String   @default("USD")
  payFrequency  String   @default("monthly") // monthly | semimonthly | biweekly | weekly
  hoursPerWeek  Float?
  reason        String? // hire | raise | promotion | adjustment | correction
  note          String?
  createdById   String?
  createdAt     DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, effectiveFrom])
}

// The org's own catalog of recurring earnings, deductions and employer costs.
// Payroll rules are jurisdiction-specific, so the engine is generic and the
// organization declares its own components rather than trusting anything we
// hard-code.
model PayComponent {
  id       String @id @default(uuid())
  tenantId String

  code         String // stable identifier used on payslip lines
  name         String
  kind         String   @default("deduction") // earning | deduction | employer_contribution
  calc         String   @default("fixed") // fixed | percent_of_base | percent_of_gross
  amount       Float    @default(0) // fixed amount, or percent when calc is a percentage
  currency     String   @default("USD")
  taxable      Boolean  @default(true) // earnings: adds to taxable pay
  preTax       Boolean  @default(false) // deductions: reduces taxable pay
  capPerPeriod Float?
  appliesTo    String   @default("all") // all | assigned  (assigned ⇒ per-employee opt-in)
  active       Boolean  @default(true)
  sortOrder    Int      @default(0)
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant      Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  assignments EmployeePayComponent[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

// One employee's assignment of (or override for) a pay component.
model EmployeePayComponent {
  id          String @id @default(uuid())
  tenantId    String
  userId      String
  componentId String

  amount        Float? // overrides the catalog amount when set
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  active        Boolean   @default(true)
  note          String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  component PayComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)

  @@unique([userId, componentId])
  @@index([tenantId, userId])
}

// Progressive income-tax bands, entered by the organization for its own
// jurisdiction. Deliberately data, not code: we do not ship "correct" tax rates
// for anywhere, because a wrong rate shipped as a default is worse than no
// default at all.
model TaxTable {
  id       String @id @default(uuid())
  tenantId String

  name         String
  jurisdiction String?
  currency     String   @default("USD")
  // [{ upTo: number|null, rate: number }] — ordered, last band has upTo null.
  bands        Json     @default("[]")
  allowance    Float    @default(0) // tax-free annual allowance
  active       Boolean  @default(true)
  isDefault    Boolean  @default(false)
  note         String?
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, active])
}

// One payroll cycle. Immutable once approved: a pay run that can be edited
// after sign-off isn't a record of what was paid.
model PayRun {
  id       String @id @default(uuid())
  tenantId String

  reference         String? // human label, e.g. "March 2026 — monthly"
  periodStart       DateTime
  periodEnd         DateTime
  payDate           DateTime
  frequency         String    @default("monthly")
  currency          String    @default("USD")
  status            String    @default("draft") // draft | review | approved | paid | cancelled
  totals            Json      @default("{}") // gross, tax, deductions, net, employerCost, headcount
  taxTableId        String?
  approvalRequestId String?
  note              String?
  calculatedAt      DateTime?
  approvedById      String?
  approvedAt        DateTime?
  paidAt            DateTime?
  paymentRef        String?
  createdById       String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payslips Payslip[]

  @@index([tenantId, status])
  @@index([tenantId, periodStart])
}

// One person's pay for one run. `lines` is the full breakdown and `snapshot`
// records the compensation the calculation used, so a payslip stays explicable
// years later even after the person's salary has changed five times.
model Payslip {
  id       String @id @default(uuid())
  tenantId String
  payRunId String
  userId   String

  currency        String   @default("USD")
  gross           Float    @default(0)
  taxableGross    Float    @default(0)
  tax             Float    @default(0)
  deductions      Float    @default(0)
  net             Float    @default(0)
  employerCost    Float    @default(0)
  hours           Float?
  daysInPeriod    Int?
  daysWorked      Int?
  unpaidLeaveDays Float    @default(0)
  prorated        Boolean  @default(false)
  lines           Json     @default("[]")
  snapshot        Json     @default("{}")
  note            String?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  payRun PayRun @relation(fields: [payRunId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([payRunId, userId])
  @@index([tenantId, userId])
}

// The org's leave catalog: holiday, sick, parental, unpaid…
model LeaveType {
  id       String @id @default(uuid())
  tenantId String

  code             String
  name             String
  paid             Boolean  @default(true)
  annualDays       Float    @default(0) // entitlement per year
  carryOverMax     Float    @default(0)
  requiresApproval Boolean  @default(true)
  countsWeekends   Boolean  @default(false)
  active           Boolean  @default(true)
  colour           String? // UI hint
  note             String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  tenant   Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  balances LeaveBalance[]
  requests LeaveRequest[]

  @@unique([tenantId, code])
  @@index([tenantId, active])
}

// Per person, per leave type, per year.
model LeaveBalance {
  id          String @id @default(uuid())
  tenantId    String
  userId      String
  leaveTypeId String
  year        Int

  entitledDays Float    @default(0)
  carriedOver  Float    @default(0)
  adjustment   Float    @default(0) // manual correction, +/-
  usedDays     Float    @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@index([tenantId, year])
}

model LeaveRequest {
  id          String @id @default(uuid())
  tenantId    String
  userId      String
  leaveTypeId String

  startDate         DateTime
  endDate           DateTime
  days              Float
  halfDay           Boolean   @default(false)
  reason            String?
  status            String    @default("pending") // pending | approved | rejected | cancelled
  approvalRequestId String?
  decidedById       String?
  decidedAt         DateTime?
  decisionNote      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, userId, startDate])
}

// Hours worked — what hourly pay is calculated from. Only APPROVED entries are
// ever paid; a draft timesheet must not be able to pay itself.
model TimeEntry {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  date          DateTime
  hours         Float
  overtimeHours Float     @default(0)
  project       String?
  note          String?
  status        String    @default("draft") // draft | submitted | approved | rejected
  approvedById  String?
  approvedAt    DateTime?
  payslipId     String? // set once paid, so hours can't be paid twice
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, project])
  @@index([tenantId, status])
  @@index([tenantId, userId, date])
}

// The employment timeline — hired, promoted, paid, left. The answer to "what
// happened with this person, and who recorded it".
model EmploymentEvent {
  id       String @id @default(uuid())
  tenantId String
  userId   String

  type        String // hired | profile | compensation | leave | timesheet | payroll | status | note | terminated
  detail      String?
  fromValue   String?
  toValue     String?
  effectiveAt DateTime?
  actorId     String?
  actorName   String?
  createdAt   DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId, userId, createdAt])
}

// ── Helpdesk: knowledge base & customer portal ────────────────────────────────
// Articles are grouped into categories the customer sees as sections.
model KbCategory {
  id          String   @id @default(uuid())
  tenantId    String
  name        String
  slug        String
  description String?
  icon        String?
  visibility  String   @default("public") // public | internal
  sortOrder   Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  articles KbArticle[]

  @@unique([tenantId, slug])
  @@index([tenantId, active])
}

// A help article. `visibility` decides whether customers can read it at all, and
// `status` whether anyone can: an unpublished article is invisible to the portal
// even when it's marked public, so drafting in the open is safe.
model KbArticle {
  id         String  @id @default(uuid())
  tenantId   String
  categoryId String?

  title      String
  slug       String
  excerpt    String?
  body       String
  tags       String[] @default([])
  visibility String   @default("public") // public | internal
  status     String   @default("draft") // draft | published | archived
  pinned     Boolean  @default(false)

  views      Int @default(0)
  helpfulYes Int @default(0)
  helpfulNo  Int @default(0)

  authorId    String?
  authorName  String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  category KbCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  feedback KbFeedback[]

  @@unique([tenantId, slug])
  @@index([tenantId, status, visibility])
  @@index([tenantId, categoryId])
}

// "Was this helpful?" — the signal that tells you which articles to rewrite.
// Kept as rows rather than only counters so the comments survive.
model KbFeedback {
  id        String   @id @default(uuid())
  tenantId  String
  articleId String
  helpful   Boolean
  comment   String?
  email     String?
  createdAt DateTime @default(now())

  tenant  Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  article KbArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([tenantId, articleId])
}

// One message on a ticket. `visibility` is the whole point: an internal note and
// a customer reply live in the same thread so an agent reads one story, but the
// portal only ever serves the public ones.
model TicketMessage {
  id       String @id @default(uuid())
  tenantId String
  ticketId String

  body           String
  authorType     String   @default("agent") // agent | customer | system
  authorId       String?
  authorName     String?
  authorEmail    String?
  visibility     String   @default("public") // public | internal
  attachmentUrl  String?
  attachmentName String?
  emailed        Boolean  @default(false) // did we manage to notify the customer?
  createdAt      DateTime @default(now())

  tenant Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ticket CrmTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([tenantId, ticketId, createdAt])
}

// A single-use, short-lived sign-in link for the customer portal. Only the
// token's SHA-256 is stored, so the database can't be used to log in as a
// customer. Customers get no password — there is nothing to leak or reset.
model PortalMagicLink {
  id        String    @id @default(uuid())
  tenantId  String
  email     String
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  ip        String?
  createdAt DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tenantId, email])
}

// A signed-in portal visitor. Also hashed; revoking is deleting the row.
model PortalSession {
  id         String   @id @default(uuid())
  tenantId   String
  email      String
  contactId  String?
  tokenHash  String
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([tenantId, email])
}
