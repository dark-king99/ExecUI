# ── Backend environment ──────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
#   cp .env.example .env

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:genius005@localhost:5432/my_ui_app"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5555
FRONTEND_URL=http://localhost:5173

# ── Auth / JWT (required) ────────────────────────────────────────────────────
# Generate strong random values: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d
# Optional separate access/refresh secrets (only if you enable rotating tokens)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Integration secret store (recommended) ───────────────────────────────────
# AES-256 master key used to encrypt outbound integration secrets at rest.
# Generate with: `openssl rand -hex 32`
# If unset, a key is derived from JWT_SECRET (OK for dev, set a dedicated one in prod).
SECRETS_KEY=

# ── Object storage ───────────────────────────────────────────────────────────
# Directory uploaded assets (avatars, etc.) are written to.
# Defaults to backend/storage/uploads when unset.
STORAGE_DIR=

# ── Stripe billing ───────────────────────────────────────────────────────────
# Fully integrated via Stripe Checkout (hosted) + webhooks.
#  • No key set  → FREE early-access mode: choosing a plan activates instantly.
#  • Key set     → PAID mode: choosing a plan opens Stripe Checkout and the plan
#                  activates once payment succeeds.
# Plan prices are created dynamically from src/modules/billing/plans.config.js
# (inline price_data), so you do NOT need to pre-create Products/Prices.
STRIPE_SECRET_KEY=
# Webhook signing secret (from `stripe listen` or a Dashboard endpoint).
# Endpoint to register: POST <api-host>/api/account/billing/webhook
# Events: checkout.session.completed, customer.subscription.updated, customer.subscription.deleted
STRIPE_WEBHOOK_SECRET=

# ── Email / Resend (optional) ────────────────────────────────────────────────
# Outbound email (invites, marketing, CRM) is sent via Resend when configured.
# Without a key, email operations are recorded as "skipped" instead of failing.
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM="ExecUI <noreply@yourdomain.com>"   # must be a verified sender
RESEND_API_KEY=re_ScPPCs9b_JVQ8nEU4aRRHKkE6nfe6ZcM4
RESEND_FROM="ExecUI <doeblah004@gmail.com>"

# ── AI assist (optional) ─────────────────────────────────────────────────────
# The AI features (Einstein copilots, content generation, insights, SOPs) call
# ONE provider-agnostic, OpenAI-compatible endpoint. Leave AI_API_KEY blank to
# run in deterministic mode: every AI feature returns a template answer, uses no
# external API, and costs $0. Set a key to switch on the live model.
#
# Recommended free provider: Groq (https://console.groq.com) — free tier, fast.
#   AI_API_KEY=gsk_xxxxxxxx
# Other OpenAI-compatible options (just change base URL + model):
#   DeepSeek:   AI_BASE_URL=https://api.deepseek.com/v1        AI_MODEL=deepseek-chat
#   OpenRouter: AI_BASE_URL=https://openrouter.ai/api/v1       AI_MODEL=meta-llama/llama-3.1-8b-instruct:free
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
#
# Cost knobs (kept small on purpose — raise only if you accept the cost):
AI_MAX_TOKENS=320          # hard cap on output tokens per request
AI_MAX_INPUT_CHARS=1200    # each message is clamped to this length
AI_MAX_HISTORY=4           # only the last N turns are sent as context
AI_TIMEOUT_MS=12000
#
# Monthly AI-request allowances are per subscription plan (see
# src/modules/billing/plans.config.js → AI_LIMITS) and enforced automatically.

# ── Logging ──────────────────────────────────────────────────────────────────
# Structured JSON request/error logs. Levels: debug | info | warn | error
LOG_LEVEL=info

# ── Product analytics (optional, PostHog server-side) ────────────────────────
# Leave blank to disable (safe no-op). Set to capture backend 5xx errors (with
# route + status + ids, no request bodies/PII) alongside the user's session, so
# you can tell which API route needs improvement.
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# ── Enterprise SSO (SAML/OIDC) + SCIM ────────────────────────────────────────
# Public base URL of this deployment. Used to build the OIDC redirect URI, the
# SAML ACS/entity ID and the SCIM base URL that you paste into your identity
# provider. Strongly recommended in production (otherwise these are derived from
# request headers). See docs/SSO.md.
APP_URL=
# Per-minute budget for SCIM provisioning calls (a directory sync bursts high).
SCIM_RATE_LIMIT_PER_MIN=1200

# ── Organization deletion ────────────────────────────────────────────────────
# Deleting an organization is staged: an admin requests it, and a scheduler
# carries out the purge once the grace window has elapsed. Until then any admin
# can cancel, and an active legal hold refuses the purge outright.
# See docs/TENANCY.md.
TENANT_DELETION_GRACE_DAYS=30
TENANT_PURGE_INTERVAL_HOURS=24

# ── Payment provider ─────────────────────────────────────────────────────────
# Which processor takes the money: stripe | manual | flutterwave.
# Unset → inferred: a Stripe key means Stripe, no key means manual (free early
# access until payment details are configured). See docs/PRICING.md.
#
# Stripe does NOT onboard merchants in every country — Liberia among them — so
# this is a real choice, not a preference.
PAYMENT_PROVIDER=

# manual: bank transfer / mobile money. An invoice is issued with a reference,
# and an operator confirms receipt. Needs no merchant onboarding at all.
PAY_BANK_NAME=
PAY_BANK_ACCOUNT_NAME=
PAY_BANK_ACCOUNT_NUMBER=
PAY_BANK_SWIFT=
PAY_MOBILE_MONEY_LABEL=          # e.g. "Orange Money" or "MTN Mobile Money"
PAY_MOBILE_MONEY_NUMBER=
PAY_MOBILE_MONEY_NAME=
PAY_INVOICE_DUE_DAYS=14

# flutterwave: cards, bank transfer, USSD and mobile money across Africa.
# NOT YET VERIFIED against a live merchant account — see docs/PRICING.md §5.
FLW_SECRET_KEY=
FLW_SECRET_HASH=                 # the value echoed in the verif-hash webhook header
FLW_BASE_URL=https://api.flutterwave.com/v3
