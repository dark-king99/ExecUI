# ── Backend environment ──────────────────────────────────────────────────────
# Copy this file to `.env` and fill in real values. NEVER commit your real .env.
#   cp .env.example .env

# ── Database (required) ──────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/my_ui_app?schema=public"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5555
FRONTEND_URL=http://localhost:5173

# ── Auth / JWT (required) ────────────────────────────────────────────────────
# Generate strong random values: `openssl rand -hex 32`
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d
# Optional separate access/refresh secrets (only if you enable rotating tokens)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Integration secret store (recommended) ───────────────────────────────────
# AES-256 master key used to encrypt outbound integration secrets at rest.
# Generate with: `openssl rand -hex 32`
# If unset, a key is derived from JWT_SECRET (OK for dev, set a dedicated one in prod).
SECRETS_KEY=

# ── Object storage ───────────────────────────────────────────────────────────
# Directory uploaded assets (avatars, etc.) are written to.
# Defaults to backend/storage/uploads when unset.
STORAGE_DIR=

# ── Stripe billing (optional) ────────────────────────────────────────────────
# Without a secret key the billing module serves demo data.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

# ── Email / Resend (optional) ────────────────────────────────────────────────
# Outbound email (invites, marketing, CRM) is sent via Resend when configured.
# Without a key, email operations are recorded as "skipped" instead of failing.
#   RESEND_API_KEY=re_xxxxxxxx
#   RESEND_FROM="ExecUI <noreply@yourdomain.com>"   # must be a verified sender
RESEND_API_KEY=
RESEND_FROM=

# ── AI assistant (optional) ──────────────────────────────────────────────────
# AI_BACKEND: auto | deepseek | openai | local | fallback
AI_BACKEND=fallback
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
