# Copy to `.env` and fill in real values. Never commit `.env` or real credentials.

# Database and server
DATABASE_URL="postgresql://user:password@localhost:5432/execui"
PORT=5555
FRONTEND_URL=http://localhost:5173
APP_URL=http://localhost:5555
# Public customer-facing frontend URL used in helpdesk portal sign-in emails.
HELPDESK_PORTAL_URL=http://localhost:5173

# Authentication
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES=1d
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
SECRETS_KEY=

# Paddle Billing (server-side only)
# Keep sandbox until live catalog, credentials, and website approval are verified.
# Choose "sandbox" with a pdl_sdbx_ key or "production" with a pdl_live_ key.
PAYMENT_PROVIDER=paddle
PADDLE_ENV=sandbox
# The key needs transaction permissions; do not put it in frontend/.env.
PADDLE_API_KEY=pdl_sdbx_replace_with_your_sandbox_api_key
PADDLE_WEBHOOK_SECRET=replace_with_your_sandbox_webhook_secret

# Paddle price IDs. Create all prices in the Paddle sandbox catalog.
# Configure prices as tax-inclusive if listed totals should include tax.
PADDLE_PRICE_STARTER_MONTH=pri_replace_with_starter_month_price_id
PADDLE_PRICE_STARTER_YEAR=pri_replace_with_starter_year_price_id
PADDLE_PRICE_STANDARD_MONTH=pri_replace_with_standard_month_price_id
PADDLE_PRICE_STANDARD_YEAR=pri_replace_with_standard_year_price_id
PADDLE_PRICE_PREMIUM_MONTH=pri_replace_with_premium_month_price_id
PADDLE_PRICE_PREMIUM_YEAR=pri_replace_with_premium_year_price_id
PADDLE_PRICE_ENTERPRISE_MONTH=pri_replace_with_enterprise_month_price_id
PADDLE_PRICE_ENTERPRISE_YEAR=pri_replace_with_enterprise_year_price_id
PADDLE_PRICE_EXECUTIVE_SMALL_OFFICE_MONTH=pri_replace_with_executive_small_office_month_price_id
PADDLE_PRICE_EXECUTIVE_SMALL_OFFICE_YEAR=pri_replace_with_executive_small_office_year_price_id
PADDLE_PRICE_EXECUTIVE_ENTERPRISE_MONTH=pri_replace_with_executive_enterprise_month_price_id
PADDLE_PRICE_EXECUTIVE_ENTERPRISE_YEAR=pri_replace_with_executive_enterprise_year_price_id

# Object storage and email
STORAGE_DIR=
RESEND_API_KEY=
RESEND_FROM=

# AI features (optional)
AI_API_KEY=
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.1-8b-instant
AI_MAX_TOKENS=320
AI_MAX_INPUT_CHARS=1200
AI_MAX_HISTORY=4
AI_TIMEOUT_MS=12000

# Logging and analytics
LOG_LEVEL=info
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# SCIM and organization deletion
SCIM_RATE_LIMIT_PER_MIN=1200
TENANT_DELETION_GRACE_DAYS=30
TENANT_PURGE_INTERVAL_HOURS=24

# Optional manual billing or Flutterwave settings
PAY_BANK_NAME=
PAY_BANK_ACCOUNT_NAME=
PAY_BANK_ACCOUNT_NUMBER=
PAY_BANK_SWIFT=
PAY_MOBILE_MONEY_LABEL=
PAY_MOBILE_MONEY_NUMBER=
PAY_MOBILE_MONEY_NAME=
PAY_INVOICE_DUE_DAYS=14
FLW_SECRET_KEY=
FLW_SECRET_HASH=
FLW_BASE_URL=https://api.flutterwave.com/v3
