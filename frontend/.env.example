# ── Frontend environment ─────────────────────────────────────────────────────
# Copy this file to `.env` and adjust if needed. NEVER commit your real .env.
#   cp .env.example .env

# Base path the SPA uses for API calls. In dev, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api

# Keep sandbox until live catalog, credentials, and website approval are verified.
# Choose sandbox with a test_ token or production with a live_ token.
VITE_PADDLE_ENV=sandbox
# Paddle browser client-side token (not the server API key).
VITE_PADDLE_CLIENT_TOKEN=test_your_paddle_client_token

# Optional WebSocket URL (leave blank if unused).
VITE_WS_URL=

# ── Product analytics (PostHog) ────────────────────────────────────────────
# Required for development. Production degrades safely when either is unset.
# Set the project key to stream pageviews, autocaptured clicks, session replay
# and UI errors so you can see where users drop off and what confuses them.
VITE_POSTHOG_KEY=your_posthog_project_token
# Use your PostHog ingestion host (for example, https://us.i.posthog.com).
VITE_POSTHOG_HOST=https://your-posthog-host
# Send names/emails to analytics too (default: off — only ids/role/plan are sent).
VITE_ANALYTICS_CAPTURE_PII=false
