# ── Frontend environment ─────────────────────────────────────────────────────
# Copy this file to `.env` and adjust if needed. NEVER commit your real .env.
#   cp .env.example .env

# Base path the SPA uses for API calls. In dev, Vite proxies /api to the backend.
VITE_API_BASE_URL=/api

# Optional WebSocket URL (leave blank if unused).
VITE_WS_URL=

# ── Product analytics (optional, PostHog) ────────────────────────────────────
# Leave blank to disable entirely (the app runs a safe no-op — nothing is sent).
# Set the project key to stream pageviews, autocaptured clicks, session replay
# and UI errors so you can see where users drop off and what confuses them.
VITE_POSTHOG_KEY=
# PostHog host — US cloud default; use https://eu.i.posthog.com or your self-host URL.
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Send names/emails to analytics too (default: off — only ids/role/plan are sent).
VITE_ANALYTICS_CAPTURE_PII=false
